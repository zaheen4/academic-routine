# Telegram Bot Configuration
# Obtain your token from @BotFather on Telegram
TELEGRAM_BOT_TOKEN="your_bot_token_here"

# Optional personal numeric Telegram User ID from @userinfobot (for admin notifications)
TELEGRAM_CHAT_ID="your_numeric_chat_id_here"

# Default section filter (e.g. B2 or B1)
DEFAULT_SECTION="B2"

# GitHub Personal Access Token (with 'gist' permission) for native cloud Gist sync
# Generate at: https://github.com/settings/tokens
GITHUB_TOKEN="ghp_your_github_personal_access_token_here"

# Google Spreadsheet Synchronization (Class Routine)
SPREADSHEET_NAME="CSE-03_B_ClassRoutine"
GOOGLE_SERVICE_ACCOUNT_KEY="google_cloud_keys/service_account_key.json"

# UCAM Student Portal Credentials for automated multi-account routine scraping
# Supports JSON array for arbitrary N accounts:
UCAM_ACCOUNTS='[
  {"id": "Account 1", "username": "CS 2203001", "password": "your_password_here", "section_label": "B2"},
  {"id": "Account 2", "username": "CS 2203999", "password": "your_password_here", "section_label": "B1"}
]'
