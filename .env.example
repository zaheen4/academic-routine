# ==============================================================================
# Telegram Bot Configuration
# ==============================================================================
# Obtain your token from @BotFather on Telegram (canonical: TELEGRAM_BOT_TOKEN; alias: TELOXIDE_TOKEN)
TELEGRAM_BOT_TOKEN="your_bot_token_here"

# Numeric Telegram chat ID for the administrator/owner (receives admin alerts and controls restricted commands)
# ADMIN_CHAT_ID is preferred; TELEGRAM_CHAT_ID is supported as fallback.
ADMIN_CHAT_ID="your_numeric_chat_id_here"
TELEGRAM_CHAT_ID="your_numeric_chat_id_here"

# Default section filter (e.g. B2, B1, or All)
DEFAULT_SECTION="B2"

# HTTP Health check server configuration (used for container platforms like Render)
# Defaults to 8000. Set PORT=0 or DISABLE_HTTP_HEALTHCHECK=1 to disable.
PORT="8000"
# DISABLE_HTTP_HEALTHCHECK=1

# ==============================================================================
# GitHub Gist & Public Calendar Subscription
# ==============================================================================
# GitHub Personal Access Token (classic, with 'gist' scope) for syncing routine.ics
# Canonical: GITHUB_TOKEN; alias: GH_TOKEN.
GITHUB_TOKEN="ghp_your_github_personal_access_token_here"

# Linked GitHub Gist ID (or set via CLI: `academic-routine set-gist <ID>`)
GIST_ID=""

# Local timezone offset in hours relative to UTC (defaults to +6 for Asia/Dhaka)
ROUTINE_TIMEZONE_OFFSET="6"

# ==============================================================================
# Google Spreadsheet Synchronization (Optional)
# ==============================================================================
SPREADSHEET_NAME="CSE-03_B_ClassRoutine"
GOOGLE_SERVICE_ACCOUNT_KEY="google_cloud_keys/service_account_key.json"

# ==============================================================================
# UCAM Student Portal Credentials (Multi-account scraping)
# ==============================================================================
# JSON array for arbitrary N accounts:
UCAM_ACCOUNTS='[
  {"id": "Account 1", "username": "CS 2203001", "password": "your_password_here", "section_label": "B2"},
  {"id": "Account 2", "username": "CS 2203999", "password": "your_password_here", "section_label": "B1"}
]'
