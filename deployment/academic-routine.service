[Unit]
Description=Academic Routine Assistant Telegram Bot & Scheduler Daemon
# No network ordering on purpose. This is a --user unit, and network.target is a
# system-scope special unit, so ordering against it here is inert: it can never
# delay this service. The startup retry covers the case where the network is not
# up yet when the daemon starts.

[Service]
Type=simple
WorkingDirectory=%h/academic-routine
Environment="PATH=%h/.cargo/bin:/usr/local/bin:/usr/bin:/bin"
EnvironmentFile=-%h/academic-routine/.env
ExecStart=%h/.cargo/bin/academic-routine bot
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
