[Unit]
Description=Academic Routine Assistant Telegram Bot & Scheduler Daemon
After=network.target

[Service]
Type=simple
WorkingDirectory=%h/academic-routine
Environment="PATH=%h/.cargo/bin:/usr/local/bin:/usr/bin:/bin"
EnvironmentFile=-%h/academic-routine/.env
ExecStart=%h/.cargo/bin/academic-routine bot
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
