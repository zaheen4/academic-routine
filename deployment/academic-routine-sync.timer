[Unit]
Description=Weekly Academic Routine Synchronization Timer

[Timer]
# Run weekly every Saturday at 8:00 PM (20:00:00)
OnCalendar=Sat *-*-* 20:00:00
# Run on boot if the scheduled time was missed while the computer was off
Persistent=true
RandomizedDelaySec=60

[Install]
WantedBy=timers.target
