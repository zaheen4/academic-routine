[Unit]
Description=Academic Routine Weekly UCAM Extraction & Gist Sync
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h/Documents/projects/academic-routine
Environment="PATH=%h/.cargo/bin:/usr/local/bin:/usr/bin:/bin"
ExecStart=%h/Documents/projects/academic-routine/target/release/academic-routine sync-ucam --force
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
