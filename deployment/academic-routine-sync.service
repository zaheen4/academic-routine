[Unit]
Description=Academic Routine Weekly UCAM Extraction & Gist Sync
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h/academic-routine
Environment="PATH=%h/.cargo/bin:/usr/local/bin:/usr/bin:/bin"
EnvironmentFile=-%h/academic-routine/.env
ExecStart=%h/.cargo/bin/academic-routine sync-ucam --force
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
